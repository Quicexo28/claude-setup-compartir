{
  "permissions": {
    "deny": [
      "Read(~/.claude/.credentials.json)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git rebase*)",
      "Bash(rm -rf*)",
      "Bash(sudo rm*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"__CLAUDE_DIR__/hooks/guard-credentials.sh\"", "timeout": 5 },
          { "type": "command", "command": "bash \"__CLAUDE_DIR__/hooks/guard-destructive.sh\"", "timeout": 5 },
          { "type": "command", "command": "bash \"__CLAUDE_DIR__/hooks/guard-secrets-commit.sh\"", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"__CLAUDE_DIR__/hooks/shellcheck-edit.sh\"", "timeout": 15 }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"__CLAUDE_DIR__/statusline.sh\""
  }
}
